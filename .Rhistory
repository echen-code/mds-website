#| label: setup
#| message: false
#| warning: false
library(readr)
library(dplyr)
library(ggplot2)
library(knitr)
df <- read_csv("gapminder.csv")
#| label: prep-data
gdp_compare <- df |>
filter(country %in% c("Taiwan", "Canada")) |>
select(country, year, gdpPercap, pop) |>
mutate(gdp_total_billions = (gdpPercap * pop) / 1e9)
head(gdp_compare)
#| label: growth-rates
growth_table <- gdp_compare |>
group_by(country) |>
summarise(
start_year = min(year),
end_year = max(year),
gdpPercap_start = gdpPercap[year == min(year)],
gdpPercap_end = gdpPercap[year == max(year)],
cagr_pct = ((gdpPercap_end / gdpPercap_start)^(1 / (end_year - start_year)) - 1) * 100
)
kable(growth_table, digits = 2, caption = "GDP per capita growth, Taiwan vs. Canada")
install.packages("rmarkdown")
renv::snapshot()
#| label: fig-gdp-percap
#| fig-cap: "GDP per capita over time, Taiwan vs. Canada (Gapminder data)."
ggplot(gdp_compare, aes(x = year, y = gdpPercap, color = country)) +
geom_line()
#| label: growth-rates
growth_table <- gdp_compare |>
group_by(country) |>
summarise(
start_year = min(year),
end_year = max(year),
gdpPercap_start = gdpPercap[year == min(year)],
gdpPercap_end = gdpPercap[year == max(year)],
cagr_pct = ((gdpPercap_end / gdpPercap_start)^(1 / (end_year - start_year)) - 1) * 100
)
kable(growth_table, digits = 2, caption = "GDP per capita growth, Taiwan vs. Canada")
#| label: fig-gdp-percap
#| fig-cap: "GDP per capita over time, Taiwan vs. Canada (Gapminder data)."
ggplot(gdp_compare, aes(x = year, y = gdpPercap, color = country)) +
geom_line()
labs(x = "Year", y = "GDP per capita")
ggplot(gdp_compare, aes(x = year, y = gdpPercap, color = country)) +
geom_line()
labs(x = "Year", y = "GDP per capita")
#| label: fig-gdp-percap
